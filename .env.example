# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Security & Authentication
JWT_SECRET=super-secret-key-change-in-production-flyrank-2026
JWT_EXPIRES_IN=86400

# Database
DB_PATH=./data/widget_platform.db

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=20
RATE_LIMIT_MAX_PER_WIDGET=50

# Geolocation Enrichment Providers
GEO_PROVIDER_A_URL=http://ip-api.com/json
GEO_PROVIDER_B_URL=https://ipapi.co
GEO_TIMEOUT_MS=1500

# Mock toggles for deterministic testing
GEO_MOCK_PROVIDER_A_FAIL=false
GEO_MOCK_PROVIDER_B_FAIL=false
SIDE_EFFECT_FAIL=false

# Secondary Side Effect Notification (Webhook or Email Log)
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_EMAIL_FROM=notifications@leadcapture.local
