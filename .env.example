# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
TRUST_PROXY=false
ALLOW_TEST_CONTROLS=true

# Security & Authentication (Cryptographically strong secret: MUST be >= 32 characters)
JWT_SECRET=flyrank_capstone_secure_production_secret_key_minimum_32_characters_2026
JWT_EXPIRES_IN=86400

# Database
DB_PATH=./data/widget_platform.db

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=20
RATE_LIMIT_MAX_PER_WIDGET=50
AUTH_RATE_LIMIT_MAX=10

# Geolocation Enrichment Providers ($0 Free tier APIs)
GEO_PROVIDER_A_URL=http://ip-api.com/json
GEO_PROVIDER_B_URL=https://ipapi.co
GEO_TIMEOUT_MS=1500

# Secondary Side Effect Notification (Webhook or Email Log)
NOTIFICATION_EMAIL_FROM=notifications@leadcapture.local
